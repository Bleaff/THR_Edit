# Maintainer: Bleaff
#
# The upstream URL below is a placeholder until the public repository exists; fix `url` and
# replace `sha256sums` with the real checksum (`updpkgsums`) before submitting to the AUR.
pkgname=thr-control
pkgver=0.1.0
pkgrel=1
pkgdesc="Unofficial editor for first-generation Yamaha THR guitar amplifiers (USB MIDI)"
arch=('any')
url="https://github.com/Bleaff/THR_Edit"
license=('AGPL-3.0-or-later')
depends=(
  'python'
  'pyside6'
  'python-mido'
  'python-rtmidi'
  'python-numpy'
  'python-pydantic'
  'python-platformdirs'
  'alsa-lib'
)
makedepends=(
  'python-build'
  'python-installer'
  'python-hatchling'
)
checkdepends=('python-pytest')
optdepends=(
  'pipewire: recording and live measurement (provides pw-record, pw-play, pw-dump)'
  'pipewire-jack: the JACK client library that python-rtmidi links against'
)
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "$pkgname-$pkgver"
  python -m build --wheel --no-isolation
}

check() {
  cd "$pkgname-$pkgver"
  # The test suite needs no amp and no display.
  QT_QPA_PLATFORM=offscreen PYTHONPATH=src python -m pytest -q -p no:cacheprovider
}

package() {
  cd "$pkgname-$pkgver"
  python -m installer --destdir="$pkgdir" dist/*.whl

  local id=io.github.bleaff.ThrControl
  install -Dm644 "packaging/linux/$id.desktop" -t "$pkgdir/usr/share/applications/"
  install -Dm644 "packaging/linux/$id.metainfo.xml" -t "$pkgdir/usr/share/metainfo/"
  install -Dm644 "src/thr_control/data/icons/$id.svg" \
    -t "$pkgdir/usr/share/icons/hicolor/scalable/apps/"
}
